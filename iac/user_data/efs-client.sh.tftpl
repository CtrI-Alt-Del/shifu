#!/bin/bash
set -euxo pipefail

dnf install -y amazon-efs-utils
mkdir -p /mnt/shifu-storage-lab

for attempt in $(seq 1 18); do
  if mount -t efs -o tls,accesspoint=${access_point_id} ${file_system_id}:/ /mnt/shifu-storage-lab; then
    echo "${file_system_id}:/ /mnt/shifu-storage-lab efs _netdev,tls,accesspoint=${access_point_id} 0 0" >> /etc/fstab
    exit 0
  fi
  sleep 10
done

echo "EFS mount did not become ready." >&2
exit 1
