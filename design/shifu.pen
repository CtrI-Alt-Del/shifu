                                    {
                                      "type": "text",
                                      "id": "Pasnk",
                                      "name": "Conteúdo de server.js",
                                      "fill": "$text-primary",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "import Fastify from \"fastify\";\n\nconst app = Fastify();\nconst tasks = [{ id: 1, title: \"Ler\", done: false }];\n\napp.get(\"/tasks\", async () => tasks);\n\napp.post(\"/tasks\", async (request, reply) => {\n  const task = { id: tasks.length + 1,\n    title: request.body.title, done: false };\n  tasks.push(task);\n  return reply.code(201).send(task);\n});\n\napp.patch(\"/tasks/:id\", async (request) => {\n  const task = tasks.find((t) =>\n    t.id === Number(request.params.id));\n  task.done = true;\n  return task;\n});\n\napp.listen({ port: 3000 });",
                                      "lineHeight": 1.55,
                                      "fontFamily": "$font-mono",
                                      "fontSize": 12,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
