                                      "name": "Conteúdo de App.jsx",
                                      "fill": "$text-primary",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "import { useState } from \"react\";\nimport TaskItem from \"./components/TaskItem\";\nimport \"./styles.css\";\n\nconst items = [\"Ler\", \"Praticar\", \"Revisar\"];\n\nexport default function App() {\n  const [done, setDone] = useState([\"Praticar\"]);\n  const toggle = (item) => setDone((current) =>\n    current.includes(item)\n      ? current.filter((x) => x !== item)\n      : [...current, item]\n  );\n\n  return <main className=\"lista\">\n    <h1>Plano de hoje</h1>\n    {items.map((item) =>\n      <TaskItem key={item} item={item}\n        done={done.includes(item)}\n        onToggle={() => toggle(item)} />\n    )}\n  </main>;\n}",
                                      "lineHeight": 1.55,
                                      "fontFamily": "$font-mono",
                                      "fontSize": 12,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
