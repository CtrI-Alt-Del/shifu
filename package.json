{
  "name": "shifu",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm dev --workspace=apps/web",
    "build:web": "pnpm build --workspace=apps/web",
    "typecheck": "pnpm typecheck --workspaces --if-present",
    "skills": "pnpm dlx skills experimental_install",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:commands": "node scripts/sync-commands.mjs",
    "sync": "pnpm sync:agents && pnpm sync:commands",
    "test": "pnpm test --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "commitlint-plugin-function-rules": "^5.0.1",
    "husky": "^9.1.7"
  }
}