SHIFU_WEB_APP_PORT=7000
SHIFU_WEB_APP_URL=http://localhost:7000
VITE_SHIFU_SERVER_URL=http://localhost:7777
SHIFU_WEB_APP_MODE=local
SHIFU_WEB_APP_LOG_LEVEL=INFO
SHIFU_RELEASE_VERSION=local-dev
# In local development, leave the shared BFF secret unset in both apps so they
# use the same local default. Set matching secrets in deployed environments.
SHIFU_TRUSTED_PROXY_IPS=
SHIFU_IDENTITY_API_URL=http://localhost:7777

BETTER_AUTH_DATABASE_URL=postgresql://shifu:shifu-local@localhost:54544/shifu
# Keep this secret stable after Better Auth creates its signing keys.
BETTER_AUTH_SECRET=replace-with-a-local-secret-of-at-least-32-characters
