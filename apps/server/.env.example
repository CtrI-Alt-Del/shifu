SHIFU_SERVER_APP_PORT=7777
SHIFU_SERVER_APP_MODE=local
SHIFU_AUTH_ISSUER=http://localhost:7000
SHIFU_AUTH_AUDIENCE=shifu-api
SHIFU_AUTH_JWKS_URL=http://localhost:7000/api/auth/jwks
SHIFU_EMAIL_PROVIDER=smtp
SHIFU_SMTP_HOST=localhost
SHIFU_SMTP_PORT=1026
SHIFU_SMTP_USERNAME=
SHIFU_SMTP_PASSWORD=
SHIFU_SMTP_START_TLS=0
SHIFU_SMTP_USE_TLS=0
SHIFU_EMAIL_FROM=no-reply@shifu.local
SHIFU_RESEND_API_KEY=
SHIFU_RESEND_FROM=
SHIFU_EMAIL_TIMEOUT_SECONDS=10
SHIFU_CONFIRMATION_ACTION_ORIGIN=http://localhost:7000
# In local development, leave the shared BFF secret unset in both apps so they
# use the same local default. Set matching secrets in deployed environments.
SHIFU_COMMUNICATION_ENCRYPTION_KEYS=

INNGEST_APP_ID=shifu
INNGEST_BASE_URL=http://localhost:18288
INNGEST_DEV=1

DATABASE_URL=postgresql+psycopg://shifu:shifu-local@localhost:54344/shifu

REDIS_URL=redis://localhost:6379/0

DIAGNOSTIC_REVISION_HMAC_KEY=

TRUSTED_PROXY_IPS=
