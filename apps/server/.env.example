SHIFU_SERVER_APP_PORT=7777
SHIFU_SERVER_APP_MODE=local
SHIFU_AUTH_ISSUER=http://localhost:7000
SHIFU_AUTH_AUDIENCE=shifu-api
SHIFU_AUTH_JWKS_URL=http://localhost:7000/api/auth/jwks
SHIFU_EMAIL_PROVIDER=smtp
SHIFU_SMTP_HOST=localhost
SHIFU_SMTP_PORT=1026
SHIFU_SMTP_USERNAME=
SHIFU_SMTP_PASSWORD=
SHIFU_SMTP_START_TLS=0
SHIFU_SMTP_USE_TLS=0
SHIFU_EMAIL_FROM=no-reply@shifu.local
SHIFU_RESEND_API_KEY=
SHIFU_RESEND_FROM=
SHIFU_EMAIL_TIMEOUT_SECONDS=10
SHIFU_CONFIRMATION_ACTION_ORIGIN=http://localhost:7000
# In local development, leave the shared BFF secret unset in both apps so they
# use the same local default. Set matching secrets in deployed environments.
SHIFU_COMMUNICATION_ENCRYPTION_KEYS=

INNGEST_APP_ID=shifu
INNGEST_BASE_URL=http://localhost:18288
INNGEST_DEV=1

DATABASE_URL=postgresql+psycopg://shifu:shifu-local@localhost:54344/shifu
AGENTOS_DATABASE_URL=postgresql+psycopg://shifu_agentos_runtime:change-me@localhost:54344/shifu

REDIS_URL=redis://localhost:6379/0

# Optional Langfuse operational monitoring for Intelligence and Learning agents.
# Keep AgentOS as the runtime; configure project keys from the local Langfuse UI.
MENTOR_TELEMETRY_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:7003
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Compatibility setting; raw prompts, answers, and JEV decisions are never exported.
MENTOR_TELEMETRY_CONTENT_ENABLED=false

DIAGNOSTIC_REVISION_HMAC_KEY=

TRUSTED_PROXY_IPS=
# Account-level prompt/response logging disabled; required for private Mentor inference.
OPENROUTER_PROMPT_LOGGING_DISABLED=false

# Private Mentor attachment storage (MinIO in local development)
MENTOR_ATTACHMENT_STORAGE_BUCKET=shifu-mentor-attachments
MENTOR_ATTACHMENT_STORAGE_REGION=us-east-1
MENTOR_ATTACHMENT_STORAGE_ENDPOINT_URL=http://localhost:9000
MENTOR_ATTACHMENT_STORAGE_ADDRESSING_STYLE=path
MENTOR_ATTACHMENT_STORAGE_ACCESS_KEY=shifu-local
MENTOR_ATTACHMENT_STORAGE_SECRET_KEY=change-me
MENTOR_ATTACHMENT_MAX_IMAGE_PIXELS=20000000
MENTOR_ATTACHMENT_MAX_PDF_PAGES=40
MENTOR_ATTACHMENT_MAX_EXTRACTED_CHARS=200000
MENTOR_ATTACHMENT_PDF_PROCESSING_TIMEOUT_SECONDS=10
MENTOR_ATTACHMENT_MAX_PDF_RENDERED_BYTES=20000000

# Module-scoped AgentOS admission bounds
AGENTOS_INTELLIGENCE_QUEUE_MAX_CONCURRENCY=4
AGENTOS_INTELLIGENCE_QUEUE_MAX_DEPTH=1000
AGENTOS_INTELLIGENCE_QUEUE_TIMEOUT_SECONDS=600
AGENTOS_LEARNING_QUEUE_MAX_CONCURRENCY=4
AGENTOS_LEARNING_QUEUE_MAX_DEPTH=1000
AGENTOS_LEARNING_QUEUE_TIMEOUT_SECONDS=600
