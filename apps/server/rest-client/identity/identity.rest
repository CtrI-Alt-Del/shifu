@baseUrl = http://localhost:7777
@accessToken = replace-with-local-test-token
@bffSharedSecret = replace-with-local-bff-secret
@erasureId = 44c3e3b4-c9db-4c8a-a347-ec9109f69b62
@browserCapability = replace-with-local-browser-capability
@accountId = 01JACCOUNT000000000000000001
@accessVersion = 1

### Identity sign-in
POST {{baseUrl}}/identity/sign-in
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "local-test-password"
}

### Current session
GET {{baseUrl}}/identity/session
Authorization: Bearer {{accessToken}}

### Main-page entry
POST {{baseUrl}}/identity/main-page-entries
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### Registration (non-secret contract example)
POST {{baseUrl}}/identity/registrations
Content-Type: application/json

{
  "display_name": "Pessoa Aprendente",
  "email": "learner@example.com",
  "password": "replace-with-local-password"
}

### Pending confirmation status (opaque handle placeholder)
POST {{baseUrl}}/identity/pending-confirmations/status
Content-Type: application/json

{
  "pending_handle": "replace-with-43-character-base64url-handle"
}

### Resend confirmation (opaque handle placeholder)
POST {{baseUrl}}/identity/pending-confirmations/resend
Content-Type: application/json

{
  "pending_handle": "replace-with-43-character-base64url-handle"
}

### Confirm e-mail (token placeholder)
POST {{baseUrl}}/identity/email-confirmations
Content-Type: application/json

{
  "token": "replace-with-43-character-base64url-token"
}

### Password recovery request (generic/opaque response)
POST {{baseUrl}}/identity/password-recovery-requests
X-Shifu-Bff-Secret: {{bffSharedSecret}}
Content-Type: application/json

{
  "email": "learner@example.com"
}

### Password recovery status (opaque handle)
POST {{baseUrl}}/identity/password-recoveries/status
X-Shifu-Bff-Secret: {{bffSharedSecret}}
Content-Type: application/json

{
  "recovery_handle": "replace-with-opaque-recovery-handle"
}

### Password recovery retry (opaque handle)
POST {{baseUrl}}/identity/password-recoveries/retry
X-Shifu-Bff-Secret: {{bffSharedSecret}}
Content-Type: application/json

{
  "recovery_handle": "replace-with-opaque-recovery-handle"
}

### Password reset (one-time token)
POST {{baseUrl}}/identity/password-resets
X-Shifu-Bff-Secret: {{bffSharedSecret}}
Content-Type: application/json

{
  "token": "replace-with-recovery-token",
  "password": "replace-with-new-password",
  "password_confirmation": "replace-with-new-password"
}

### Password reset link status (one-time token placeholder)
POST {{baseUrl}}/identity/password-reset-links/status
X-Shifu-Bff-Secret: {{bffSharedSecret}}
Content-Type: application/json

{
  "token": "replace-with-43-character-base64url-recovery-token"
}


### Read canonical account profile (replace JWT and shared secret locally)
GET {{baseUrl}}/identity/accounts/me
Authorization: Bearer {{accessToken}}
x-shifu-bff-secret: {{bffSharedSecret}}

### Update own profile
PATCH {{baseUrl}}/identity/accounts/me
Authorization: Bearer {{accessToken}}
x-shifu-bff-secret: {{bffSharedSecret}}
Content-Type: application/json

{"display_name": "Aprendiz", "time_zone": "America/Sao_Paulo"}

### Change own password with current session preserved
POST {{baseUrl}}/identity/accounts/me/password
Authorization: Bearer {{accessToken}}
x-shifu-bff-secret: {{bffSharedSecret}}
Content-Type: application/json

{"current_password": "replace-locally-current", "new_password": "replace-locally-new"}

### Close own account (202 closed with pending/completed erasure state)
POST {{baseUrl}}/identity/account-deletions
Authorization: Bearer {{accessToken}}
x-shifu-bff-secret: {{bffSharedSecret}}
Content-Type: application/json

{"erasure_id": "{{erasureId}}", "current_password": "replace-locally-current", "confirmed": true}

### Read account erasure recovery status (200; 404 when absent)
GET {{baseUrl}}/identity/internal/account-erasures/{{erasureId}}/status
x-shifu-bff-secret: {{bffSharedSecret}}

### Read pending account erasure target (200; 404 after completion)
GET {{baseUrl}}/identity/internal/account-erasures/{{erasureId}}/target
x-shifu-bff-secret: {{bffSharedSecret}}

### Acknowledge an account erasure participant (200; duplicate is idempotent)
POST {{baseUrl}}/identity/internal/account-erasures/{{erasureId}}/acknowledgements
x-shifu-bff-secret: {{bffSharedSecret}}
Content-Type: application/json

{"participant": "learning"}

### Admit a Better Auth account activity while its external shared gate is held (204; 401 when closed/stale)
POST {{baseUrl}}/identity/internal/account-activity-admissions
x-shifu-bff-secret: {{bffSharedSecret}}
Content-Type: application/json

{"account_id": "{{accountId}}", "access_version": {{accessVersion}}}

### Issue an opaque browser data capability for the signed-in account (201)
POST {{baseUrl}}/identity/browser-data-capabilities
Authorization: Bearer {{accessToken}}
x-shifu-bff-secret: {{bffSharedSecret}}

### Validate a browser data capability online (200 active/revoked; no session required)
POST {{baseUrl}}/identity/browser-data-validations
Content-Type: application/json

{"capability": "{{browserCapability}}"}
