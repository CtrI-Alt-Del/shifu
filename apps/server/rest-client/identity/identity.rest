@baseUrl = http://localhost:7777
@accessToken = replace-with-local-test-token
@bffSharedSecret = replace-with-local-bff-secret

### Identity sign-in
POST {{baseUrl}}/identity/sign-in
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "local-test-password"
}

### Current session
GET {{baseUrl}}/identity/session
Authorization: Bearer {{accessToken}}

### Main-page entry
POST {{baseUrl}}/identity/main-page-entries
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### Registration (non-secret contract example)
POST {{baseUrl}}/identity/registrations
Content-Type: application/json

{
  "display_name": "Pessoa Aprendente",
  "email": "learner@example.com",
  "password": "replace-with-local-password"
}

### Pending confirmation status (opaque handle placeholder)
POST {{baseUrl}}/identity/pending-confirmations/status
Content-Type: application/json

{
  "pending_handle": "replace-with-43-character-base64url-handle"
}

### Resend confirmation (opaque handle placeholder)
POST {{baseUrl}}/identity/pending-confirmations/resend
Content-Type: application/json

{
  "pending_handle": "replace-with-43-character-base64url-handle"
}

### Confirm e-mail (token placeholder)
POST {{baseUrl}}/identity/email-confirmations
Content-Type: application/json

{
  "token": "replace-with-43-character-base64url-token"
}

### Password recovery request (generic/opaque response)
POST {{baseUrl}}/identity/password-recovery-requests
X-Shifu-Bff-Secret: {{bffSharedSecret}}
Content-Type: application/json

{
  "email": "learner@example.com"
}

### Password recovery status (opaque handle)
POST {{baseUrl}}/identity/password-recoveries/status
X-Shifu-Bff-Secret: {{bffSharedSecret}}
Content-Type: application/json

{
  "recovery_handle": "replace-with-opaque-recovery-handle"
}

### Password recovery retry (opaque handle)
POST {{baseUrl}}/identity/password-recoveries/retry
X-Shifu-Bff-Secret: {{bffSharedSecret}}
Content-Type: application/json

{
  "recovery_handle": "replace-with-opaque-recovery-handle"
}

### Password reset (one-time token)
POST {{baseUrl}}/identity/password-resets
X-Shifu-Bff-Secret: {{bffSharedSecret}}
Content-Type: application/json

{
  "token": "replace-with-recovery-token",
  "password": "replace-with-new-password",
  "password_confirmation": "replace-with-new-password"
}

### Password reset link status (one-time token placeholder)
POST {{baseUrl}}/identity/password-reset-links/status
X-Shifu-Bff-Secret: {{bffSharedSecret}}
Content-Type: application/json

{
  "token": "replace-with-43-character-base64url-recovery-token"
}
