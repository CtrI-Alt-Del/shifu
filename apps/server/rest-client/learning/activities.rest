@baseUrl = http://localhost:7777
@accessToken = replace-with-local-test-token
@goalId = 01SHF000000000000000000012
@skillId = 01SHF000000000000000000002
@competencyId = 01SHF000000000000000000020
@activityId = 01SHF000000000000000000023
@attemptId = replace-with-submitted-attempt-id
@submissionKey = 75e29c3d-8bc2-4e4d-9103-cc747a170012

### Get choice Activity
GET {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}
Authorization: Bearer {{accessToken}}

### Submit choice Activity attempt
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "submission_key": "{{submissionKey}}",
  "answers": [
    { "question_key": "question-one", "selected_option_keys": ["correct"] },
    { "question_key": "question-two", "selected_option_keys": ["correct"] },
    { "question_key": "question-three", "selected_option_keys": ["correct"] }
  ]
}

### Get choice Activity attempt result
GET {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts/{{attemptId}}
Authorization: Bearer {{accessToken}}

### Retry failed choice Activity evaluation
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts/{{attemptId}}/retry
Authorization: Bearer {{accessToken}}
