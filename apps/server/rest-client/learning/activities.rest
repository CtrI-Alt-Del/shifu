@baseUrl = http://localhost:7777
@accessToken = replace-with-local-test-token
@goalId = 01SHF000000000000000000012
@skillId = 01SHF000000000000000000002
@competencyId = 01SHF000000000000000000020
@activityId = 01SHF000000000000000000023
@attemptId = replace-with-submitted-attempt-id
@submissionKey = 75e29c3d-8bc2-4e4d-9103-cc747a170011
@activityRevision = replace-with-activity-revision-from-get
@codeQuestionKey = replace-with-stdin-question-key
@reactQuestionKey = replace-with-react-question-key
@reactFastifyQuestionKey = replace-with-integrated-question-key

### GET Activity — choice or mixed question sequence
GET {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}
Authorization: Bearer {{accessToken}}

### POST preliminary feedback — one mixed Activity question, no attempt
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/questions/{{codeQuestionKey}}/preliminary-evaluations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "activity_revision": "{{activityRevision}}",
  "answer": {
    "kind": "javascript_stdin",
    "question_key": "{{codeQuestionKey}}",
    "files": [
      { "path": "src/main.js", "content": "process.stdin.on('data', chunk => console.log(chunk.toString().trim()))" }
    ]
  }
}

### POST preliminary feedback — React question with a curricular additional-file policy
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/questions/{{reactQuestionKey}}/preliminary-evaluations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "activity_revision": "{{activityRevision}}",
  "answer": {
    "kind": "react",
    "question_key": "{{reactQuestionKey}}",
    "files": [
      { "path": "src/App.tsx", "content": "export default function App() { return <main>Hello</main> }" },
      { "path": "src/components/Header.tsx", "content": "export function Header() { return <header>Header</header> }" }
    ]
  }
}

### POST mixed Activity attempt — use all ordered answers and the GET revision
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "submission_key": "{{submissionKey}}",
  "activity_revision": "{{activityRevision}}",
  "answers": [
    { "kind": "single_choice", "question_key": "question-one", "selected_option_keys": ["a"] },
    { "kind": "multiple_selection", "question_key": "question-two", "selected_option_keys": ["a", "c"] },
    { "kind": "javascript_stdin", "question_key": "{{codeQuestionKey}}", "files": [
      { "path": "src/main.js", "content": "process.stdin.on('data', chunk => console.log(chunk.toString().trim()))" }
    ] }
  ]
}

### GET Activity attempt result — pending, failed or completed
GET {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts/{{attemptId}}
Authorization: Bearer {{accessToken}}

### POST retry — same saved Activity attempt after failed official evaluation
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts/{{attemptId}}/retry
Authorization: Bearer {{accessToken}}

@adaptiveGoalId = replace-with-created-goal-id
@adaptiveSkillId = 01SHF000000000000000000032
@adaptiveCompetencyId = 01SHF000000000000000000033
@firstDiagnosticActivityId = 01SHF000000000000000000036
@diagnosticAttemptId = replace-with-submitted-diagnostic-attempt-id
@diagnosticRunId = 75e29c3d-8bc2-4e4d-9103-cc747a170011
@diagnosticSubmissionKey = 75e29c3d-8bc2-4e4d-9103-cc747a170014

### Get any diagnostic Activity in the activitySequence before final submission
GET {{baseUrl}}/learning/goals/{{adaptiveGoalId}}/skills/{{adaptiveSkillId}}/competencies/{{adaptiveCompetencyId}}/activities/{{firstDiagnosticActivityId}}
Authorization: Bearer {{accessToken}}
X-Diagnostic-Run-Id: {{diagnosticRunId}}

### Submit all diagnostic Activities once at the end (repeat the same key/body for replay)
### Include every ordered item from GET /diagnostic; this one-item body is a template only.
POST {{baseUrl}}/learning/goals/{{adaptiveGoalId}}/skills/{{adaptiveSkillId}}/diagnostic/submissions
Authorization: Bearer {{accessToken}}
X-Diagnostic-Run-Id: {{diagnosticRunId}}
Content-Type: application/json

{
  "submission_key": "{{diagnosticSubmissionKey}}",
  "items": [
    {
      "competency_id": "{{adaptiveCompetencyId}}",
      "activity_id": "{{firstDiagnosticActivityId}}",
      "activity_revision": "replace-with-opaque-revision",
      "answers": [{ "question_key": "q1", "selected_option_keys": ["a"] }]
    }
  ]
}

### Retry a failed diagnostic evaluation; individual result GET stays private
POST {{baseUrl}}/learning/goals/{{adaptiveGoalId}}/skills/{{adaptiveSkillId}}/competencies/{{adaptiveCompetencyId}}/activities/{{firstDiagnosticActivityId}}/attempts/{{diagnosticAttemptId}}/retry
Authorization: Bearer {{accessToken}}
X-Diagnostic-Run-Id: {{diagnosticRunId}}

### POST preliminary feedback — one integrated frontend/API answer, no attempt
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/questions/{{reactFastifyQuestionKey}}/preliminary-evaluations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "activity_revision": "{{activityRevision}}",
  "answer": {
    "kind": "react_fastify",
    "question_key": "{{reactFastifyQuestionKey}}",
    "files": [
      { "path": "src/App.jsx", "content": "export default function App() { return <main>Tarefas</main> }" },
      { "path": "routes/api.js", "content": "import Fastify from 'fastify'; const api = Fastify(); api.get('/api/tasks', async () => [{id: 1, title: 'Aprender', done: false}]); await api.listen({port: 3000, host: '0.0.0.0'});" }
    ]
  }
}

### POST complete integrated Activity — replace all question keys/files from GET
### 201 for creation, 200 for identical replay, 409 for same key with changed answers.
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "submission_key": "{{submissionKey}}",
  "activity_revision": "{{activityRevision}}",
  "answers": [
    { "kind": "single_choice", "question_key": "question-one", "selected_option_keys": ["a"] },
    { "kind": "single_choice", "question_key": "question-two", "selected_option_keys": ["a"] },
    { "kind": "react_fastify", "question_key": "{{reactFastifyQuestionKey}}", "files": [
      { "path": "src/App.jsx", "content": "export default function App() { return <main>Tarefas</main> }" },
      { "path": "routes/api.js", "content": "import Fastify from 'fastify'; const api = Fastify(); api.get('/api/tasks', async () => []); await api.listen({port: 3000, host: '0.0.0.0'});" }
    ] }
  ]
}

### GET integrated attempt — saved snapshot/response, without starting practice
GET {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts/{{attemptId}}
Authorization: Bearer {{accessToken}}

### POST recovery — same saved integrated answer and attempt, no replacement files
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts/{{attemptId}}/retry
Authorization: Bearer {{accessToken}}
