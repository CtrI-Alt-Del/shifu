@baseUrl = http://localhost:7777
@accessToken = replace-with-local-test-token
@goalId = 01SHF000000000000000000012
@skillId = 01SHF000000000000000000002
@competencyId = 01SHF000000000000000000020
@activityId = 01SHF000000000000000000023
@attemptId = replace-with-submitted-attempt-id
@submissionKey = 75e29c3d-8bc2-4e4d-9103-cc747a170011
@activityRevision = replace-with-activity-revision-from-get
@passageKey = replace-with-new-passage-uuid
@orderingQuestionKey = replace-with-ordering-question-key-from-get
@codeQuestionKey = replace-with-stdin-question-key
@reactQuestionKey = replace-with-react-question-key
@htmlCssJsQuestionKey = replace-with-html-css-js-question-key
@reactFastifyQuestionKey = replace-with-integrated-question-key
@fillBlanksQuestionKey = fill-1
@pairQuestionKey = replace-with-pair-matching-question-key

### GET Activity — choice or mixed question sequence
GET {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}
Authorization: Bearer {{accessToken}}

# For an HTML/CSS/JavaScript question in the response, `kind` is `html_css_js`.
# Its detail includes `initial_files`, `entrypoint`, `editable_paths`,
# `fixed_dependencies`, `permitted_commands` and rubric `criteria`.
# For a new ordering passage, generate one UUID for `passageKey`; the initial GET
# returns `ordering_passage_key: null`. Reuse the UUID for every preview and the
# final submission. After a verified passage is resumed, reuse its returned
# `ordering_passage_key` instead. The response includes an incorrect stable
# initial order and never includes accepted orders or grading explanations.

### POST preliminary feedback — verify one ordering question in this passage
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/questions/{{orderingQuestionKey}}/preliminary-evaluations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "activity_revision": "{{activityRevision}}",
  "passage_key": "{{passageKey}}",
  "answer": {
    "kind": "ordering",
    "question_key": "{{orderingQuestionKey}}",
    "ordered_step_keys": ["step-one", "step-two", "step-three"]
  }
}

# A conclusive response contains a fixed 100/0 score, `is_correct` and the
# explanation. Replaying this request returns the same result; another order for
# the same question/passage is rejected.

### POST preliminary feedback — one mixed Activity question, no attempt
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/questions/{{codeQuestionKey}}/preliminary-evaluations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "activity_revision": "{{activityRevision}}",
  "answer": {
    "kind": "javascript_stdin",
    "question_key": "{{codeQuestionKey}}",
    "files": [
      { "path": "src/main.js", "content": "process.stdin.on('data', chunk => console.log(chunk.toString().trim()))" }
    ]
  }
}

### POST preliminary feedback — React question with a curricular additional-file policy
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/questions/{{reactQuestionKey}}/preliminary-evaluations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "activity_revision": "{{activityRevision}}",
  "answer": {
    "kind": "react",
    "question_key": "{{reactQuestionKey}}",
    "files": [
      { "path": "src/App.tsx", "content": "export default function App() { return <main>Hello</main> }" },
      { "path": "src/components/Header.tsx", "content": "export function Header() { return <header>Header</header> }" }
    ]
  }
}

### POST preliminary feedback — HTML/CSS/JavaScript question
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/questions/{{htmlCssJsQuestionKey}}/preliminary-evaluations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "activity_revision": "{{activityRevision}}",
  "answer": {
    "kind": "html_css_js",
    "question_key": "{{htmlCssJsQuestionKey}}",
    "files": [
      { "path": "index.html", "content": "<main><h1>Minha página</h1></main>" },
      { "path": "src/styles.css", "content": "main { max-width: 60rem; margin: auto; }" },
      { "path": "src/main.js", "content": "document.querySelector('main')?.setAttribute('data-ready', 'true')" }
    ]
  }
}

### POST preliminary feedback — fill-in-the-blank question with a word bank, no attempt
# Every blank must carry one distinct bank occurrence; `word_key` values come from the
# GET `bank`. The 200 body has `score`, `correct_blank_count`, `blank_count` and the
# predefined `explanation`, and never the accepted words. A complete but wrong fill is
# valid; an incomplete or repeated one is 400. The kind is not accepted in a diagnostic.
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/questions/{{fillBlanksQuestionKey}}/preliminary-evaluations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "activity_revision": "{{activityRevision}}",
  "answer": {
    "kind": "fill_blanks",
    "question_key": "{{fillBlanksQuestionKey}}",
    "placements": [
      { "blank_key": "b1", "word_key": "w1" },
      { "blank_key": "b2", "word_key": "w3" },
      { "blank_key": "b3", "word_key": "w4" }
    ]
  }
}

### GET Activity — pair matching question in the sequence
# A `pair_matching` question lists `words` and `translations` in display order and
# never carries the answer key. Its item keys are opaque: copy them from this
# response into the requests below.
GET {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}
Authorization: Bearer {{accessToken}}

### POST preliminary feedback — pair matching question, no attempt
# Every word and every translation appears exactly once. The 200 body has the
# submitted pairs, `correct_pair_count`, `total_pair_count`, `score`, `outcome`
# (`full`, `partial` or `incorrect`) and the predefined `explanation`. It never marks
# individual pairs and never reveals expected pairs. An incomplete or repeated pairing
# is 400. The kind is not accepted in a diagnostic.
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/questions/{{pairQuestionKey}}/preliminary-evaluations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "activity_revision": "{{activityRevision}}",
  "answer": {
    "kind": "pair_matching",
    "question_key": "{{pairQuestionKey}}",
    "pairs": [
      { "word_key": "w-3f9a21c4", "translation_key": "t-e2480b6d" },
      { "word_key": "w-b07d5e18", "translation_key": "t-91c7d3fa" },
      { "word_key": "w-5c1e9a73", "translation_key": "t-0a6b4e25" }
    ]
  }
}

### POST Activity attempt with a pair matching question (201 created, 200 replay)
# Send every ordered answer. The same pairs in another order replay the same attempt.
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "submission_key": "{{submissionKey}}",
  "activity_revision": "{{activityRevision}}",
  "answers": [
    { "kind": "single_choice", "question_key": "question-one", "selected_option_keys": ["a"] },
    { "kind": "single_choice", "question_key": "question-two", "selected_option_keys": ["a"] },
    { "kind": "pair_matching", "question_key": "{{pairQuestionKey}}", "pairs": [
      { "word_key": "w-3f9a21c4", "translation_key": "t-91c7d3fa" },
      { "word_key": "w-b07d5e18", "translation_key": "t-e2480b6d" },
      { "word_key": "w-5c1e9a73", "translation_key": "t-0a6b4e25" }
    ] }
  ]
}

### GET Activity attempt result — pair matching question
# The `pair_matching` result has `submitted_pairs`, `correct_pair_count`,
# `total_pair_count`, `score`, `outcome` and `explanation`. `disclosed_correct_pairs`
# appears only after a later fully correct attempt or Competency mastery.
GET {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts/{{attemptId}}
Authorization: Bearer {{accessToken}}

### POST mixed Activity attempt — use all ordered answers and the GET revision
POST {{baseUrl}}/learning/goals/{{goalId}}/skills/{{skillId}}/competencies/{{competencyId}}/activities/{{activityId}}/attempts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "submission_key": "{{submissionKey}}",
  "activity_revision": "{{activityRevision}}",
  "answers": [
    { "kind": "single_choice", "question_key": "question-one", "selected_option_keys": ["a"] },
    { "kind": "multiple_selection", "question_key": "question-two", "selected_option_keys": ["a", "c"] },
    { "kind": "javascript_stdin", "question_key": "{{codeQuestionKey}}", "files": [
      { "path": "src/main.js", "content": "process.stdin.on('data', chunk => console.log(chunk.toString().trim()))" }
    ] },
    { "kind": "html_css_js", "question_key": "{{htmlCssJsQuestionKey}}", "files": [
      { "path": "index.html", "content": "<main><h1>Minha página</h1></main>" },
      { "path": "src/styles.css", "content": "main { max-width: 60rem; margin: auto; }" },
      { "path": "src/main.js", "content": "document.querySelector('main')?.setAttribute('data-ready', 'true')" }
    ] }
  ]
}

