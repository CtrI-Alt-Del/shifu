@baseUrl = http://localhost:7777
@accessToken = replace-with-local-test-token
@mentorSessionId = 01J00000000000000000000000
@planningId = 01J00000000000000000000004
@goalId = 01J00000000000000000000001
@skillId = 01J00000000000000000000002
@attemptId = 01J00000000000000000000003
@lastSequence = 0
@nextSubmissionKey = 236118d8-a7a0-445a-bbc6-927780aec501
@cancelSubmissionKey = d4475f31-38a7-4e7c-870e-927780aec502
@retrySubmissionKey = e4475f31-38a7-4e7c-870e-927780aec503
@submissionKey = 2a7e963f-d7dd-4cc9-9a46-8c650193f7a6

### Start planning session
POST {{baseUrl}}/intelligence/planning-sessions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "initial_intent": "Quero aprender a programar em Python do zero."
}

### Create Mentor conversation
POST {{baseUrl}}/intelligence/mentor-sessions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "submission_key": "{{submissionKey}}",
  "first_message": "Quero entender como funcionam funções em Python."
}

### List Mentor conversations
GET {{baseUrl}}/intelligence/mentor-sessions?search=python
Authorization: Bearer {{accessToken}}

### Open a Mentor conversation
GET {{baseUrl}}/intelligence/mentor-sessions/{{mentorSessionId}}
Authorization: Bearer {{accessToken}}

### Rename a Mentor conversation
PATCH {{baseUrl}}/intelligence/mentor-sessions/{{mentorSessionId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Funções em Python"
}

### Delete a Mentor conversation
DELETE {{baseUrl}}/intelligence/mentor-sessions/{{mentorSessionId}}
Authorization: Bearer {{accessToken}}

### Create with page focus (hint does not authorize these resources)
POST {{baseUrl}}/intelligence/mentor-sessions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "submission_key": "fd28e3e8-4500-4f84-92f0-98b5a876eac6",
  "first_message": "Como está meu progresso nesta Habilidade?",
  "context_hint": {
    "goal_id": "{{goalId}}",
    "skill_id": "{{skillId}}"
  }
}

### Submit next text; repeat exact payload for 200 replay
POST {{baseUrl}}/intelligence/mentor-sessions/{{mentorSessionId}}/messages
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "submission_key": "{{nextSubmissionKey}}",
  "content": "Explique o conceito e mostre meu progresso.",
  "context_hint": null
}

### Divergent same-key replay is 409
POST {{baseUrl}}/intelligence/mentor-sessions/{{mentorSessionId}}/messages
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "submission_key": "{{nextSubmissionKey}}",
  "content": "Texto diferente.",
  "context_hint": null
}

### Cancel current queued/processing attempt
POST {{baseUrl}}/intelligence/mentor-sessions/{{mentorSessionId}}/responses/{{attemptId}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "submission_key": "{{cancelSubmissionKey}}" }

### Retry failed/cancelled; original learner message/hint retained
POST {{baseUrl}}/intelligence/mentor-sessions/{{mentorSessionId}}/responses/{{attemptId}}/retry
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "submission_key": "{{retrySubmissionKey}}" }

### Approved complete blocks only; replay begins after cursor
GET {{baseUrl}}/intelligence/mentor-sessions/{{mentorSessionId}}/events
Authorization: Bearer {{accessToken}}
Accept: text/event-stream
Last-Event-ID: {{lastSequence}}

### Read planning session state (polled while status is processing)
GET {{baseUrl}}/intelligence/planning-sessions/{{planningId}}
Authorization: Bearer {{accessToken}}

### Answer the current question batch (202 while the next step is processed)
POST {{baseUrl}}/intelligence/planning-sessions/{{planningId}}/answers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "batch_id": "batch-1",
  "answers": [
    { "question_id": "q1", "option_ids": ["o2"] },
    { "question_id": "q2", "option_ids": ["o1", "o3"] }
  ]
}

### Restart the planning with a new intention (new generation, 202)
POST {{baseUrl}}/intelligence/planning-sessions/{{planningId}}/restart
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "initial_intent": "Quero aprender a criar APIs web com JavaScript."
}

### Retry after a recoverable failure (202)
POST {{baseUrl}}/intelligence/planning-sessions/{{planningId}}/retry
Authorization: Bearer {{accessToken}}

### Cancel and discard the planning (204)
DELETE {{baseUrl}}/intelligence/planning-sessions/{{planningId}}
Authorization: Bearer {{accessToken}}

### Confirm the active proposal and create the Goal in Learning (same key replays)
POST {{baseUrl}}/intelligence/planning-sessions/{{planningId}}/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "confirmation_key": "3f0c2b9e-8d1a-4c57-9b2e-6a1d4f8c0e21",
  "title": "Automatizar tarefas do dia a dia com Python",
  "description": "Quero parar de fazer planilha na mão e escrever scripts que resolvam isso por mim."
}
