# Shifu application database
POSTGRES_DB=shifu
POSTGRES_USER=shifu
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=54344
AGENTOS_RUNTIME_ROLE_PASSWORD=change-me

# Redis
REDIS_PORT=6379

# Inngest
INNGEST_PORT=18288
INNGEST_APP_ID=shifu
INNGEST_BASE_URL=http://localhost:18288
INNGEST_DEV=1
INNGEST_GATEWAY_PORT=18289
INNGEST_APP_URL=http://host.docker.internal:7777/api/inngest

# FastAPI
SHIFU_SERVER_APP_PORT=7777

# Web
WEB_APP_PORT=7000

# SonarQube database (internal-only; not published to the host)
SONAR_DB_USER=sonarqube
SONAR_DB_PASSWORD=change-me

# SonarQube web UI/API
SONAR_PORT=19000

# Mailpit
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=54326

# Private Mentor attachment storage (separate from the optional Langfuse MinIO)
MENTOR_ATTACHMENT_STORAGE_PORT=9000
MENTOR_ATTACHMENT_STORAGE_BUCKET=shifu-mentor-attachments
MENTOR_ATTACHMENT_STORAGE_ACCESS_KEY=shifu-local
MENTOR_ATTACHMENT_STORAGE_SECRET_KEY=change-me
MENTOR_ATTACHMENT_PDF_PROCESSING_TIMEOUT_SECONDS=10
MENTOR_ATTACHMENT_MAX_PDF_RENDERED_BYTES=20000000

# Optional local Langfuse stack (profile: langfuse)
LANGFUSE_PORT=7003
LANGFUSE_URL=http://localhost:7003
LANGFUSE_MINIO_PORT=9090
LANGFUSE_MINIO_URL=http://localhost:9090

MENTOR_TELEMETRY_CONTENT_ENABLED=false
